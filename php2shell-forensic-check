#!/usr/bin/env bash
# ==============================================================================
# Tactical RMM Script: Forensic Check, Patch Auditor & Actionable Hardening
# PHP2Shell (CVE-2026-109618 / 109619)
# Multi-Host hardened: Nextcloud, WordPress, Mailcow, ISPConfig, Plesk, Moodle
# Supports: Upstream Releases (8.2-8.5) & Sury Backports (7.4, 8.0, 8.1 >= 20261021)
# ==============================================================================

set -u

ALERT_FOUND=0
SCAN_DAYS=5

# Liste ignorierter Versionen für dauerhaft isolierte Stacks
IGNORE_VERSIONS="${IGNORE_VERSIONS:-}"

RECOMMENDATIONS=()

add_rec() {
    RECOMMENDATIONS+=("$1")
}

log_ok() { echo "[OK] $1"; }
log_info() { echo "[INFO] $1"; }
log_warn() { echo "[WARN] $1"; }
log_crit() { echo "[CRITICAL] $1"; ALERT_FOUND=1; }

echo "=== Tactical RMM: PHP2Shell Forensic Scan & Patch Auditor ==="
echo "Host: $(hostname -f 2>/dev/null || hostname) | Date: $(date -u)"
echo "------------------------------------------------------------"

# ==============================================================================
# 0. Runtime-Erkennung (Early Exit bei Systemen ohne PHP)
# ==============================================================================
HAS_PHP_HOST=0
HAS_PHP_DOCKER=0

if command -v php >/dev/null 2>&1 || pgrep -f "php-fpm" >/dev/null 2>&1; then
    HAS_PHP_HOST=1
fi

if command -v docker >/dev/null 2>&1; then
    if docker ps --format "{{.Image}} {{.Names}}" 2>/dev/null | grep -Ei "(php|mailcow|nextcloud|sogo|wordpress)" >/dev/null 2>&1; then
        HAS_PHP_DOCKER=1
    fi
fi

if [ "$HAS_PHP_HOST" -eq 0 ] && [ "$HAS_PHP_DOCKER" -eq 0 ]; then
    log_ok "Keine PHP-Runtime (weder Host noch Docker-Container) aktiv."
    echo "------------------------------------------------------------"
    echo "STATUS: OK - Non-PHP Host."
    exit 0
fi

# ==============================================================================
# 0b. PHP Patch-Level, Prozess-Audit & Härtungs-Check
# ==============================================================================
echo -e "\n[*] 0b. Prüfung von PHP-Patchstand, laufenden Prozessen & Härtung..."

version_ge() {
    printf '%s\n%s' "$2" "$1" | sort -C -V
}

# Prüft, ob ein Sury-Paket oder Build-Timestamp einen Security-Backport (>= 21.10.2026) enthält
check_sury_backport() {
    local full_v_output="$1"
    local bin_path="$2"

    # 1. Prüfe Paketversion via dpkg (falls Host-Binary)
    if command -v dpkg-query >/dev/null 2>&1 && [ -x "$bin_path" ]; then
        local deb_ver
        deb_ver=$(dpkg-query -S "$bin_path" 2>/dev/null | awk '{print $1}' | tr -d ':' | xargs -r dpkg-query -W -f='${Version}' 2>/dev/null || true)
        if echo "$deb_ver" | grep -qE "(deb\.sury\.org|~[0-9]{8})"; then
            local build_date
            build_date=$(echo "$deb_ver" | grep -oE '[0-9]{8}' | head -n 1)
            if [ -n "$build_date" ] && [ "$build_date" -ge 20261021 ]; then
                return 0
            fi
        fi
    fi

    # 2. Fallback: Parse Build-Datum direkt aus 'php -v'
    if echo "$full_v_output" | grep -qiE "(built:.*Oct (2[1-9]|3[01]) 2026|built:.*(Nov|Dec) 2026)"; then
        return 0
    fi

    # 3. Sury Timestamp direkt im String (z. B. ~20261021)
    local raw_date
    raw_date=$(echo "$full_v_output" | grep -oE '~[0-9]{8}' | tr -d '~' | head -n 1)
    if [ -n "$raw_date" ] && [ "$raw_date" -ge 20261021 ]; then
        return 0
    fi

    return 1
}

audit_php_hardening() {
    local exec_cmd="$1"
    local major_minor="$2"
    local is_patched="$3"
    local target_desc="$4"

    local up_enabled
    local mem_limit
    local post_max

    up_enabled=$($exec_cmd -r 'echo ini_get("session.upload_progress.enabled");' 2>/dev/null || echo "1")
    mem_limit=$($exec_cmd -r 'echo ini_get("memory_limit");' 2>/dev/null || echo "unknown")
    post_max=$($exec_cmd -r 'echo ini_get("post_max_size");' 2>/dev/null || echo "unknown")

    echo "    --- Aktive Härtungswerte (${major_minor}) ---"
    
    if [ "$up_enabled" = "0" ] || [ "$up_enabled" = "" ]; then
        echo "    [+] session.upload_progress.enabled = Off (CVE-2026-109619 Pfad blockiert)"
    else
        if [ "$is_patched" -eq 1 ]; then
            echo "    [i] session.upload_progress.enabled = On (Gepatcht; Deaktivierung empfohlen, falls ungenutzt)"
        else
            echo "    [!] session.upload_progress.enabled = On -> SICHERHEITSRISIKO bei ungepatchtem PHP!"
            add_rec "[HÄRTUNG] In der php.ini von $target_desc 'session.upload_progress.enabled = 0' setzen und Dienst neu starten."
        fi
    fi

    if [ "$mem_limit" = "-1" ]; then
        echo "    [+] memory_limit = -1 (PHP-OOM-Trigger blockiert)"
    else
        echo "    [i] memory_limit = $mem_limit (Advisory-Notfallwert: -1 via php_admin_value)"
        if [ "$is_patched" -eq 0 ]; then
            add_rec "[HÄRTUNG] Für ungepatchtes $target_desc 'memory_limit = -1' via php_admin_value setzen, um OOM-Abbrüche zu verhindern."
        fi
    fi

    echo "    [i] post_max_size = $post_max (Advisory: 8M ohne Uploads, 32M mit Uploads)"

    if [ "$major_minor" = "8.5" ]; then
        local fe_bt
        fe_bt=$($exec_cmd -r 'echo ini_get("fatal_error_backtraces");' 2>/dev/null || echo "1")
        if [ "$fe_bt" = "0" ]; then
            echo "    [+] fatal_error_backtraces = 0 (CVE-2026-109619 Backtrace-Pfad blockiert)"
        else
            echo "    [!] fatal_error_backtraces = $fe_bt -> EMPFEHLUNG: Bei PHP 8.5 auf 0 setzen!"
            add_rec "[HÄRTUNG] In der php.ini von $target_desc 'fatal_error_backtraces = 0' eintragen."
        fi
    fi
}

check_php_patch() {
    local v_raw="$1"
    local context="$2"
    local exec_cmd="${3:-php}"
    local bin_path="${4:-}"
    
    local v=$(echo "$v_raw" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)
    
    if [ -z "$v" ]; then
        log_warn "[$context] Konnte PHP-Version nicht eindeutig parsen ($v_raw)."
        return 0
    fi

    local major_minor=$(echo "$v" | cut -d. -f1,2)
    local is_safe=0
    local is_sury_backport=0

    # Whitelist-Prüfung für manuell ignorierte Versionen
    if [ -n "$IGNORE_VERSIONS" ] && [[ " $IGNORE_VERSIONS " =~ [[:space:]]${major_minor}[[:space:]] ]]; then
        log_warn "[$context] PHP $v ist ungepatcht, aber via IGNORE_VERSIONS ignoriert (intern isoliert)."
        audit_php_hardening "$exec_cmd" "$major_minor" 0 "$context"
        return 0
    fi

    case "$major_minor" in
        8.2) version_ge "$v" "8.2.35" && is_safe=1 ;;
        8.3) version_ge "$v" "8.3.36" && is_safe=1 ;;
        8.4) version_ge "$v" "8.4.27" && is_safe=1 ;;
        8.5) version_ge "$v" "8.5.12" && is_safe=1 ;;
        7.4|8.0|8.1)
            # EOL-Zweige: Prüfen, ob Sury-Sicherheitsbackport (Build >= 20261021) vorliegt
            if check_sury_backport "$v_raw" "$bin_path"; then
                is_safe=1
                is_sury_backport=1
            else
                is_safe=0
            fi
            ;;
        *)
            is_safe=0
            ;;
    esac

    if [ "$is_safe" -eq 1 ]; then
        if [ "$is_sury_backport" -eq 1 ]; then
            log_ok "[$context] PHP $v (EOL) ist via Sury Security-Backport (>= 20261021) GEFIXT."
        else
            log_ok "[$context] PHP $v ist GEFIXT gegen PHP2Shell."
        fi
        audit_php_hardening "$exec_cmd" "$major_minor" 1 "$context"
        return 0
    else
        log_crit "[$context] PHP $v ist UNGEPATCHT und angreifbar!"
        audit_php_hardening "$exec_cmd" "$major_minor" 0 "$context"
        add_rec "[UPDATE] $context: Auf gepatchte Version bringen (Upstream >= 8.2.35 oder Sury-Backport >= 20261021 einspielen)."
        return 1
    fi
}

# 1. Host PHP CLI & Binaries prüfen
if command -v php >/dev/null 2>&1; then
    HOST_PHP_VER=$(php -v 2>/dev/null | head -n 2)
    HOST_BIN=$(command -v php)
    check_php_patch "$HOST_PHP_VER" "Host CLI Binary" "php" "$HOST_BIN"
fi

# 2. Laufende FPM-Master-/Worker-Prozesse im RAM analysieren
FPM_PIDS=$(pgrep -f "php-fpm: master process" 2>/dev/null || pgrep -f "php-fpm" 2>/dev/null || true)
if [ -n "$FPM_PIDS" ]; then
    for pid in $FPM_PIDS; do
        if [ -e "/proc/$pid/exe" ]; then
            EXE_PATH=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
            if [ -n "$EXE_PATH" ] && [ -x "$EXE_PATH" ]; then
                PROC_VER=$("$EXE_PATH" -v 2>/dev/null | head -n 2 || true)
                check_php_patch "$PROC_VER" "Running Process PID $pid ($EXE_PATH)" "$EXE_PATH" "$EXE_PATH"
                
                if readlink "/proc/$pid/exe" | grep -q "(deleted)"; then
                    log_crit "NEUSTART ERFORDERLICH: FPM-Prozess $pid läuft noch mit alter Binary im RAM!"
                    add_rec "[NEUSTART] FPM-Dienst neu starten, um aktualisierte Binaries auszuführen: 'systemctl restart php*-fpm'"
                fi
            fi
        fi
    done
fi

# 3. Docker PHP Container prüfen
if [ "$HAS_PHP_DOCKER" -eq 1 ]; then
    PHP_CONTAINERS=$(docker ps --format "{{.Names}}" | grep -E "(php|web|mailcow|nextcloud|sogo|wordpress)" || true)
    for c in $PHP_CONTAINERS; do
        if docker exec "$c" which php >/dev/null 2>&1; then
            C_PHP_VER=$(docker exec "$c" php -v 2>/dev/null | head -n 2 || true)
            if [ -n "$C_PHP_VER" ]; then
                if ! check_php_patch "$C_PHP_VER" "Docker Container [$c]" "docker exec $c php" ""; then
                    add_rec "[DOCKER UPDATE] Container [$c] aktualisieren: 'docker compose pull $c && docker compose up -d $c' bzw. './update.sh'."
                fi
            fi
        fi
    done
fi

# ==============================================================================
# 1. Session Storage & Injection Scan (Nur echte PHP-Session-Dateien)
# ==============================================================================
echo -e "\n[*] 1. Session Storage Scan..."
SESSION_DIRS="/var/lib/php/sessions"

if command -v php >/dev/null 2>&1; then
    PHP_SESS_PATH=$(php -r 'echo ini_get("session.save_path");' 2>/dev/null || true)
    [ -n "$PHP_SESS_PATH" ] && [ -d "$PHP_SESS_PATH" ] && SESSION_DIRS="$SESSION_DIRS $PHP_SESS_PATH"
fi

if [ "$HAS_PHP_DOCKER" -eq 1 ]; then
    DOCKER_SESS_VOLS=$(find /var/lib/docker/volumes -maxdepth 3 -type d -name "_data" 2>/dev/null | grep -E "(session|php)" || true)
    SESSION_DIRS="$SESSION_DIRS $DOCKER_SESS_VOLS"
fi

FOUND_SESS_INJ=0
for sdir in $(echo "$SESSION_DIRS" | tr ' ' '\n' | sort -u); do
    if [ -d "$sdir" ]; then
        SUSP=$(find "$sdir" -maxdepth 2 -type f \( -name "sess_*" -o -name "*.sess" \) \
            -exec grep -I -Erl "(<\?php|<\?=|[Oa]:[0-9]+:\"|upload_progress)" {} + 2>/dev/null || true)
        if [ -n "$SUSP" ]; then
            log_crit "Verdächtige Session-Injections in $sdir gefunden:"
            echo "$SUSP" | head -n 10
            FOUND_SESS_INJ=1
            add_rec "[FORENSIK] Betroffene Sessions manuell isolieren/prüfen: $SUSP (Kopieren nach /root/forensics vor dem Löschen)."
        fi
    fi
done

for tdir in /tmp /var/tmp; do
    SUSP_TMP=$(find "$tdir" -maxdepth 1 -type f -name "sess_*" \
        -exec grep -I -Erl "(<\?php|<\?=|[Oa]:[0-9]+:\"|upload_progress)" {} + 2>/dev/null || true)
    if [ -n "$SUSP_TMP" ]; then
        log_crit "Verdächtige PHP-Session-Injections in $tdir/sess_* gefunden:"
        echo "$SUSP_TMP" | head -n 10
        FOUND_SESS_INJ=1
        add_rec "[FORENSIK] Session-Injections in $tdir/sess_* analysieren und entfernen."
    fi
done

[ "$FOUND_SESS_INJ" -eq 0 ] && log_ok "Keine PHP-Tags oder Exploit-Payloads in Sessions gefunden."

# ==============================================================================
# 2. Dateisystem-Prüfung (Web-Roots & Temp-Executables)
# ==============================================================================
echo -e "\n[*] 2. Dateisystem-Prüfung auf modifizierte PHP-Dateien & Executables..."
SEARCH_ROOTS=""
for p in /var/www /home /var/piler/www /opt/mailcow-dockerized/data/web; do
    [ -d "$p" ] && SEARCH_ROOTS="$SEARCH_ROOTS $p"
done

if [ -n "$SEARCH_ROOTS" ]; then
    RECENT_PHP=$(find $SEARCH_ROOTS -maxdepth 6 \
        \( -type d \( -name "store" -o -name "cache" -o -name "apps" -o -name "wflogs" -o -name "languages" \) -prune \) -o \
        \( -type f \( -name "*.php" -o -name "*.phtml" -o -name "*.phar" \) ! -name "*.l10n.php" -mtime -$SCAN_DAYS -print \) 2>/dev/null || true)
    
    if [ -n "$RECENT_PHP" ]; then
        log_warn "Kürzlich geänderte PHP-Dateien außerhalb von Caches/Apps (letzte $SCAN_DAYS Tage):"
        echo "$RECENT_PHP" | head -n 15
        add_rec "[AUDIT] Modifizierte PHP-Dateien sichten. (Hinweis auf False Positive: Bei CMS-Updates, Git-Pulls oder Plugin-Aktivierungen völlig normal)."
    else
        log_ok "Keine auffällig modifizierten PHP-Dateien in Web-Roots."
    fi
fi

SUSP_BINARIES=$(find /tmp /dev/shm /var/tmp -maxdepth 3 -type f \( -perm -111 -o -name "*.so" -o -name "*.sh" -o -name "*.py" -o -name "*.pl" \) 2>/dev/null | \
    grep -Ev "(systemd-private|tmp\.[A-Za-z0-9]+|\.mount_|coolwsd|appimage_extracted|/tmp/oscap\.|/tmp/apt-key-gpghome\.)" || true)

if [ -n "$SUSP_BINARIES" ]; then
    log_crit "Unerwartete Binaries/Skripte in flüchtigen Pfaden entdeckt:"
    echo "$SUSP_BINARIES" | head -n 15
    add_rec "[ALARM] Unbekannte Binaries/Skripte in flüchtigen Pfaden gefunden. Manuelle Prüfung mit: 'file <Pfad>' und 'ls -lu <Pfad>'."
    add_rec "        (Hinweis auf False Positive: Temporäre Build-Tools, Cron-Wrapper oder Paketmanager-Instanzen, die nicht im Whitelist-Filter erfasst sind)."
else
    log_ok "Keine verdächtigen Executables in /tmp oder /dev/shm."
fi

# ==============================================================================
# 3. Prozessbaum-Prüfung (Web-User Subprozesse)
# ==============================================================================
echo -e "\n[*] 3. Prozessbaum-Prüfung (Web-User Subprozesse)..."
SUSP_PROCS=$(ps -eo user,pid,ppid,args 2>/dev/null | \
    grep -E "^(www-data|nginx|nobody|web[0-9]+|clp|psacln|psaserv)\s+" | \
    grep -E "(curl|wget|nc|ncat|netcat|socat|/bin/sh|/bin/bash|/bin/dash)" | \
    grep -v grep | \
    grep -Ev "(olefy\.py|whitelist_forwardinghosts\.sh|notify_push|coolwsd|Collabora|\.mount_|appimage_extracted)" | \
    grep -Ev "(admin/cli/cron\.php|wp-cron\.php|occ|artisan|bin/console)" || true)

if [ -n "$SUSP_PROCS" ]; then
    log_crit "Verdächtige interaktive Shells oder Downloader unter Web-Usern aktiv:"
    echo "$SUSP_PROCS"
    add_rec "[ALARM] Aktive interaktive Shells unter Web-Usern gefunden! Sofort Prozessbaum mit 'ps auxf' prüfen und verdächtige PIDs beenden."
    add_rec "        (Hinweis auf False Positive: Neu eingerichtete CLI-Wartungsskripte, Cronjobs oder Deployment-Hooks, die Shells aufrufen)."
else
    log_ok "Keine verdächtigen interaktiven Shells unter Web-Usern."
fi

# ==============================================================================
# 4. Logfile-Analyse (I/O-geschützt: nur .log der letzten 7 Tage)
# ==============================================================================
echo -e "\n[*] 4. Analyse von Access- & Error-Logs..."
LOG_DIRS=""
[ -d "/var/log" ] && LOG_DIRS="/var/log"

if [ "$HAS_PHP_DOCKER" -eq 1 ]; then
    MC_VOL=$(find /var/lib/docker/volumes -maxdepth 3 -type d -name "_data" 2>/dev/null | grep "nginx-log-vol-1" | head -n 1 || true)
    [ -n "$MC_VOL" ] && LOG_DIRS="$LOG_DIRS $MC_VOL"
fi

RECENT_LOGS=$(find $LOG_DIRS -maxdepth 3 -type f \( -name "*access*.log" -o -name "*error*.log" -o -name "nextcloud.log" \) -mtime -7 2>/dev/null || true)

if [ -n "$RECENT_LOGS" ]; then
    CRASH_LOGS=$(grep -Ei "(allowed memory size.*exhausted|child.*terminated on signal|segmentation fault)" $RECENT_LOGS 2>/dev/null | \
        grep -Ei "(Oct|Okt|2026-10)" | tail -n 10 || true)

    if [ -n "$CRASH_LOGS" ]; then
        log_warn "Aktuelle Crash- oder Memory-Exhaustion-Spuren (Oktober 2026):"
        echo "$CRASH_LOGS"
        add_rec "[LOG-AUDIT] FPM-Crashes oder OOM-Meldungen untersuchen. (Hinweis auf False Positive: Reguläre OOM-Events durch ressourcenintensive PHP-Exporte oder Gallery-Rendering)."
    else
        log_ok "Keine aktuellen FPM-Worker-Crashes oder OOM-Meldungen."
    fi

    HIGH_POST_IPS=$(grep -h "POST " $RECENT_LOGS 2>/dev/null | \
        awk '$7 ~ /\.php/ {print $1}' | \
        sort | uniq -c | awk '$1 > 300 {print $1 " Anfragen von IP: " $2}' || true)

    if [ -n "$HIGH_POST_IPS" ]; then
        log_crit "Potenzieller Brute-Force / Exploit-Scan entdeckt (>300 POSTs auf .php):"
        echo "$HIGH_POST_IPS"
        add_rec "[FIREWALL] IPs mit extremen POST-Raten auf PHP-Dateien temporär via Fail2ban oder Firewall/OPNsense blockieren."
        add_rec "           (Hinweis auf False Positive: Webhooks, Synchronisations-Clients oder API-Polls)."
    else
        log_ok "Keine auffälligen POST-Anfragefluten auf PHP-Endpunkte verzeichnet."
    fi
else
    log_ok "Keine aktuellen Logdateien zur Prüfung gefunden."
fi

# ==============================================================================
# 5. Docker Container Diff (RootFS-Prüfung)
# ==============================================================================
if [ "$HAS_PHP_DOCKER" -eq 1 ]; then
    echo -e "\n[*] 5. Docker Container Rootfs Diffs..."
    PHP_CONTAINERS=$(docker ps --format "{{.Names}}" | grep -E "(php|web|mailcow|nextcloud|sogo|mariadb)" || true)
    
    for c in $PHP_CONTAINERS; do
        DIFF_CHECK=$(docker diff "$c" 2>/dev/null | \
            grep -E "^[AC] .*(bin/|tmp/|shm/|\.php$|\.sh$|\.so$)" | \
            grep -Ev "(supervisor.*\.log|healthcheck_status|mailcowauth|redis-conf\.sh|source_env\.sh|init_db\.inc\.php|cjson\.so|optimize-fts\.sh|imapsync_runner\.pl|maildir_gc\.sh|postdrop|postqueue|postlog|libpostfix|\.css$|\.js$|uid_[0-9]+|/run/s6/|\.lock$|iam-sync)" | \
            head -n 5 || true)
            
        if [ -n "$DIFF_CHECK" ]; then
            log_crit "Verdächtige RootFS-Änderungen in Container [$c]:"
            echo "$DIFF_CHECK"
            add_rec "[DOCKER FORENSIK] Rootfs-Änderungen in [$c] prüfen. (Hinweis auf False Positive: Container-eigene Locking-Files, Run-Pipes oder nachträglich installierte Tools)."
        fi
    done
fi

# ==============================================================================
# 6. Strukturierte Handlungsempfehlungen & Status-Ausgabe
# ==============================================================================
echo -e "\n------------------------------------------------------------"
echo "=== ZUSAMMENFASSUNG & HANDLUNGSEMPFEHLUNGEN ==="

if [ ${#RECOMMENDATIONS[@]} -eq 0 ]; then
    echo "[+] Keine Maßnahmen erforderlich: Alle Systeme sind gepatcht, Dienste laufen aktuell und keine verdächtigen Spuren gefunden."
else
    for rec in "${RECOMMENDATIONS[@]}"; do
        echo " -> $rec"
    done
fi

echo "------------------------------------------------------------"
if [ "$ALERT_FOUND" -ne 0 ]; then
    echo "STATUS: CRITICAL - Handlungsbedarf bei Versionen, Neustarts oder verdächtigen Artefakten!"
    exit 1
else
    echo "STATUS: OK - Keine akuten Indikatoren für PHP2Shell gefunden."
    exit 0
fi